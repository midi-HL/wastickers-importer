<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="320" />
    <translate android:fromYDelta="4%" android:toYDelta="0" android:duration="320" />
    <scale android:fromXScale="0.98" android:toXScale="1"
        android:fromYScale="0.98" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="320" />
</set>
