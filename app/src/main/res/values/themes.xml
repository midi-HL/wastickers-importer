<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fallback seed palette. Android 12+ applies ThemeOverlay.Material3.DynamicColors.DayNight. -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="dynamicColorThemeOverlay">@style/ThemeOverlay.Material3.DynamicColors.DayNight</item>
        <item name="colorPrimary">@color/seed_primary</item>
        <item name="colorOnPrimary">@color/seed_on_primary</item>
        <item name="colorPrimaryContainer">@color/seed_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/seed_on_primary_container</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorSurfaceContainer">@color/md3_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/md3_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/md3_surface_container_high</item>
        <item name="android:colorBackground">@color/md3_surface</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.App.StickerCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>
</resources>
