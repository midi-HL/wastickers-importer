<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base palette for the launch window. Activities apply the user's palette before inflating views. -->
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/seed_primary</item>
        <item name="colorOnPrimary">@color/seed_on_primary</item>
        <item name="colorPrimaryContainer">@color/seed_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/seed_on_primary_container</item>
        <item name="colorSurface">@color/md3_surface</item>
        <item name="colorSurfaceContainer">@color/md3_surface_container</item>
        <item name="colorSurfaceContainerLow">@color/md3_surface_container_low</item>
        <item name="colorSurfaceContainerHigh">@color/md3_surface_container_high</item>
        <item name="android:colorBackground">@color/md3_surface</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Large</item>
        <item name="textInputStyle">@style/Widget.App.TextInput</item>
        <item name="textInputOutlinedStyle">@style/Widget.App.TextInput</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheet</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="ThemeOverlay.App.SeedBase" parent="">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="colorSurfaceContainerLowest">?attr/colorSurface</item>
        <item name="colorSurfaceContainerHighest">?attr/colorSurfaceContainerHigh</item>
        <item name="colorSurfaceVariant">?attr/colorSurfaceContainerHigh</item>
        <item name="colorOutline">?attr/colorOnSurfaceVariant</item>
        <item name="colorOutlineVariant">?attr/colorSurfaceContainerHigh</item>
    </style>

    <!-- Compact type scale for 720p portrait: readable without the bulky default M3 headline sizes. -->
    <style name="TextAppearance.App.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">30sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="fontFamily">sans</item>
    </style>

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="contentPadding">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.StickerCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>
    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.Corner.Medium"><item name="cornerSize">16dp</item></style>
    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.Corner.Large"><item name="cornerSize">24dp</item></style>
    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge"><item name="cornerSize">28dp</item></style>
    <style name="ShapeAppearance.App.Pill" parent="ShapeAppearance.Material3.Corner.ExtraLarge"><item name="cornerFamily">rounded</item><item name="cornerSize">50%</item></style>
    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item><item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item><item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>
    <style name="ThemeOverlay.App.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.App.BottomSheet</item>
    </style>
    <style name="Widget.App.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Large</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>
</resources>
